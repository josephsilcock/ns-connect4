generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Games {
    id Int @id @default(autoincrement())
    playerOneName String
    playerTwoName String
    winner String
}

model GameStatus {
    id Int @id @default(autoincrement())
    board Json
    state String
    currentPlayer Int 
    updatedAt DateTime @updatedAt
}
